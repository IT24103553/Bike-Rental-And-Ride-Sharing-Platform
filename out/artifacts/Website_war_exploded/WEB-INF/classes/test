import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import org.mindrot.jbcrypt.BCrypt;

// Abstract User class to define common user behavior (Abstraction)
abstract class User {
    protected String username;
    protected String email;
    protected String city;
    protected String nic;

    public User(String username, String email, String city, String nic) {
        this.username = username;
        this.email = email;
        this.city = city;
        this.nic = nic;
    }

    // Encapsulation: Getters for user properties
    public String getUsername() { return username; }
    public String getEmail() { return email; }
    public String getCity() { return city; }
    public String getNic() { return nic; }

    // Abstract method to determine user type (Abstraction)
    public abstract boolean isAdmin();
    public abstract String getRedirectPage();
}

// Regular User class inheriting from User
class RegularUser extends User {
    public RegularUser(String username, String email, String city, String nic) {
        super(username, email, city, nic);
    }

    @Override
    public boolean isAdmin() {
        return false;
    }

    @Override
    public String getRedirectPage() {
        return "index.jsp";
    }
}

// AdminUser class inheriting from User (Inheritance)
class AdminUser extends User {
    private static final String ADMIN_EMAIL = "admin@gmail.com";
    private static final String ADMIN_PASSWORD_HASH = "$2a$10$rMYISwxff.smNhOuMdtr0uoxFAU8/hafewJJ874e6wypQY1PvpvLa";

    public AdminUser(String username, String email, String city, String nic) {
        super(username, email, city, nic);
